{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private user account preferences and safety state. Never readable by other users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the account owner" },
        "anonymousHandle": { "type": "string", "description": "Pseudonymous handle such as @anon_user" },
        "guest": { "type": "boolean", "description": "Whether the user started in anonymous guest mode" },
        "themeMode": { "type": "string", "enum": ["light", "dark"], "description": "Preferred UI theme mode" },
        "colorTheme": { "type": "string", "description": "Selected color theme key" },
        "fontFamily": { "type": "string", "description": "Selected typography font key" },
        "useSystemFont": { "type": "boolean", "description": "Whether to use the device system default font" },
        "compactMode": { "type": "boolean", "description": "Whether real-time compact UI resizing mode is enabled for smaller phone displays" },
        "keepAnonymousDefault": { "type": "boolean", "description": "Default state of Keep it anonymous toggle" },
        "notificationsEnabled": { "type": "boolean", "description": "Whether push and activity notifications are enabled" },
        "safetyGuidelinesAccepted": { "type": "boolean", "description": "Whether community safety terms were accepted" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "anonymousHandle",
        "guest",
        "themeMode",
        "keepAnonymousDefault",
        "notificationsEnabled",
        "safetyGuidelinesAccepted",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Publicly visible pseudonymous identity profile containing zero PII, with optional custom name, surname, gender, age, interests, and gallery avatar.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID" },
        "displayName": { "type": "string", "description": "Public display name" },
        "surname": { "type": "string", "description": "Optional surname or family/alias name" },
        "anonymousHandle": { "type": "string", "description": "Pseudonymous handle" },
        "gender": { "type": "string", "enum": ["", "Male", "Female"], "description": "User gender (Male or Female)" },
        "age": { "type": "integer", "description": "User age in years" },
        "interests": { "type": "string", "description": "Comma-separated or freeform user interests" },
        "avatarKey": { "type": "string", "description": "Selected anonymous avatar preset key" },
        "avatarUri": { "type": "string", "description": "Optional custom anonymous avatar URI chosen from device gallery" },
        "postCount": { "type": "integer" },
        "viewCount": { "type": "integer" },
        "likeCount": { "type": "integer" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "anonymousHandle",
        "avatarKey",
        "postCount",
        "viewCount",
        "likeCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ConfessionPost": {
      "title": "ConfessionPost",
      "description": "An anonymous or pseudonymous confession post with no word limit.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string", "description": "Author UID for ownership enforcement" },
        "anonymousLabel": { "type": "string", "description": "Displayed author label" },
        "anonymousHandle": { "type": "string", "description": "Displayed handle" },
        "authorAvatarUri": { "type": "string", "description": "Optional anonymous avatar URI of author" },
        "isAnonymous": { "type": "boolean" },
        "type": { "type": "string", "enum": ["text", "image", "video", "audio", "other"] },
        "category": { "type": "string" },
        "text": { "type": "string", "description": "Confession body text (no word limit, up to 50000 characters)" },
        "mediaUri": { "type": "string" },
        "mediaCaption": { "type": "string" },
        "mediaDurationSec": { "type": "integer" },
        "mediaMimeType": { "type": "string" },
        "topics": { "type": "string" },
        "contentWarning": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft", "hidden"] },
        "likeCount": { "type": "integer" },
        "commentCount": { "type": "integer" },
        "viewCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "authorUid",
        "anonymousLabel",
        "anonymousHandle",
        "isAnonymous",
        "type",
        "text",
        "status",
        "likeCount",
        "commentCount",
        "viewCount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account settings and preferences"
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public pseudonymous profile metadata"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/ConfessionPost" },
      "description": "Top-level confession posts"
    }
  }
}
