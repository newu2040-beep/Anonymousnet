rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasValidTimestampsOnCreate() {
      return request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
    }

    function hasValidTimestampsOnUpdate() {
      return request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
    }

    // 1. Private User Account (/users/{userId})
    function isValidUserAccount(data, userId) {
      return data.uid is string
          && data.uid == userId
          && data.anonymousHandle is string
          && data.anonymousHandle.size() >= 2
          && data.anonymousHandle.size() <= 40
          && data.guest is bool
          && data.themeMode in ['light', 'dark']
          && (!('colorTheme' in data) || (data.colorTheme is string && data.colorTheme.size() <= 40))
          && (!('fontFamily' in data) || (data.fontFamily is string && data.fontFamily.size() <= 40))
          && (!('useSystemFont' in data) || data.useSystemFont is bool)
          && (!('compactMode' in data) || data.compactMode is bool)
          && data.keepAnonymousDefault is bool
          && data.notificationsEnabled is bool
          && data.safetyGuidelinesAccepted is bool;
    }

    // 2. Public Profile (/publicProfiles/{userId})
    function isValidPublicProfile(data, userId) {
      return data.uid is string
          && data.uid == userId
          && data.displayName is string
          && data.displayName.size() >= 1
          && data.displayName.size() <= 60
          && (!('surname' in data) || (data.surname is string && data.surname.size() <= 60))
          && data.anonymousHandle is string
          && data.anonymousHandle.size() >= 2
          && data.anonymousHandle.size() <= 40
          && (!('gender' in data) || (data.gender is string && data.gender in ['', 'Male', 'Female']))
          && (!('age' in data) || (data.age is int && data.age >= 0 && data.age <= 120))
          && (!('interests' in data) || (data.interests is string && data.interests.size() <= 500))
          && data.avatarKey is string
          && data.avatarKey.size() >= 1
          && data.avatarKey.size() <= 60
          && (!('avatarUri' in data) || (data.avatarUri is string && data.avatarUri.size() <= 2048))
          && data.postCount is int && data.postCount >= 0
          && data.viewCount is int && data.viewCount >= 0
          && data.likeCount is int && data.likeCount >= 0
          && (!('followersCount' in data) || (data.followersCount is int && data.followersCount >= 0))
          && (!('followingCount' in data) || (data.followingCount is int && data.followingCount >= 0));
    }

    // 3. Confession Post (/posts/{postId}) — No word limits (up to 50,000 characters)
    function isValidConfessionPost(data) {
      return data.authorUid is string
          && data.anonymousLabel is string
          && data.anonymousLabel.size() >= 1
          && data.anonymousLabel.size() <= 60
          && data.anonymousHandle is string
          && data.anonymousHandle.size() >= 2
          && data.anonymousHandle.size() <= 40
          && (!('authorAvatarUri' in data) || (data.authorAvatarUri is string && data.authorAvatarUri.size() <= 2048))
          && data.isAnonymous is bool
          && data.type in ['text', 'image', 'video', 'audio', 'other']
          && (!('category' in data) || (data.category is string && data.category.size() <= 60))
          && data.text is string
          && data.text.size() >= 1
          && data.text.size() <= 50000
          && data.status in ['published', 'draft', 'hidden']
          && data.likeCount is int && data.likeCount >= 0
          && data.commentCount is int && data.commentCount >= 0
          && data.viewCount is int && data.viewCount >= 0
          && (!('mediaUri' in data) || (data.mediaUri is string && data.mediaUri.size() <= 2048))
          && (!('mediaCaption' in data) || (data.mediaCaption is string && data.mediaCaption.size() <= 500))
          && (!('mediaDurationSec' in data) || (data.mediaDurationSec is int && data.mediaDurationSec >= 0 && data.mediaDurationSec <= 7200))
          && (!('mediaMimeType' in data) || (data.mediaMimeType is string && data.mediaMimeType.size() <= 100))
          && (!('topics' in data) || (data.topics is string && data.topics.size() <= 300))
          && (!('contentWarning' in data) || (data.contentWarning is string && data.contentWarning.size() <= 120));
    }

    // 4. Post Comment (/posts/{postId}/comments/{commentId})
    function isValidComment(data, postId) {
      return data.postId is string
          && data.postId == postId
          && data.authorUid is string
          && data.anonymousLabel is string
          && data.anonymousLabel.size() >= 1
          && data.anonymousLabel.size() <= 60
          && data.text is string
          && data.text.size() >= 1
          && data.text.size() <= 10000
          && data.status in ['published', 'hidden'];
    }

    // 5. Saved or Liked Ref (/users/{userId}/savedPosts/{postId} and /users/{userId}/likedPosts/{postId})
    function isValidSavedOrLikedRef(data, userId, postId) {
      return data.userId is string
          && data.userId == userId
          && data.postId is string
          && data.postId == postId
          && data.postText is string
          && data.postText.size() <= 50000
          && data.postType in ['text', 'image', 'video', 'audio', 'other']
          && data.anonymousLabel is string
          && data.anonymousLabel.size() <= 60
          && (!('postMediaUri' in data) || (data.postMediaUri is string && data.postMediaUri.size() <= 2048));
    }

    // 6. Content Report (/reports/{reportId})
    function isValidReport(data) {
      return data.reporterUid is string
          && data.reporterUid == request.auth.uid
          && data.targetType in ['post', 'comment', 'user', 'message']
          && data.targetId is string
          && data.targetId.size() >= 1
          && data.targetId.size() <= 120
          && data.reason in ['harassment', 'threats', 'self_harm', 'sexual_exploitation', 'hate', 'spam', 'impersonation', 'privacy', 'illegal', 'other']
          && data.details is string
          && data.details.size() <= 2000
          && data.status == 'submitted';
    }

    // 7. Blocked User Ref (/users/{userId}/blocks/{blockedUid})
    function isValidBlockRef(data, userId, blockedUid) {
      return data.userId is string
          && data.userId == userId
          && data.blockedUid is string
          && data.blockedUid == blockedUid
          && data.blockedLabel is string
          && data.blockedLabel.size() <= 60;
    }

    // 8. Follow Ref (/users/{userId}/following/{targetUid})
    function isValidFollowRef(data, userId, targetUid) {
      return data.followerUid is string
          && data.followerUid == userId
          && data.targetUid is string
          && data.targetUid == targetUid
          && data.targetHandle is string
          && data.targetHandle.size() <= 60;
    }

    // 9. User Notification (/users/{userId}/notifications/{notificationId})
    function isValidNotification(data, userId) {
      return data.userId is string
          && data.userId == userId
          && data.type in ['comment', 'like', 'safety', 'system', 'activity', 'follow', 'dm_request', 'dm_message']
          && data.title is string
          && data.title.size() >= 1
          && data.title.size() <= 120
          && data.body is string
          && data.body.size() >= 1
          && data.body.size() <= 1000
          && data.isRead is bool
          && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 120));
    }

    // 10. Conversation (/conversations/{conversationId})
    function isValidConversation(data) {
      return data.participantUids is list
          && data.participantUids.size() == 2
          && request.auth.uid in data.participantUids
          && data.initiatorUid is string
          && data.recipientUid is string
          && data.status in ['pending', 'accepted', 'declined', 'blocked']
          && data.lastMessageText is string
          && data.lastMessageText.size() <= 2000
          && data.lastMessageSenderUid is string
          && data.initiatorHandle is string
          && data.initiatorHandle.size() <= 60
          && data.recipientHandle is string
          && data.recipientHandle.size() <= 60;
    }

    // 11. DirectMessage (/conversations/{conversationId}/messages/{messageId})
    function isValidDirectMessage(data, conversationId) {
      return data.conversationId is string
          && data.conversationId == conversationId
          && data.senderUid is string
          && data.senderUid == request.auth.uid
          && data.recipientUid is string
          && data.text is string
          && data.text.size() >= 1
          && data.text.size() <= 2000
          && (!('mediaUri' in data) || (data.mediaUri is string && data.mediaUri.size() <= 2048));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'uid', 'anonymousHandle', 'guest', 'themeMode', 'colorTheme', 'fontFamily',
            'useSystemFont', 'compactMode', 'keepAnonymousDefault', 'notificationsEnabled',
            'safetyGuidelinesAccepted', 'createdAt', 'updatedAt'
          ])
          && isValidUserAccount(request.resource.data, userId)
          && hasValidTimestampsOnCreate();
      allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'anonymousHandle', 'guest', 'themeMode', 'colorTheme', 'fontFamily',
            'useSystemFont', 'compactMode', 'keepAnonymousDefault', 'notificationsEnabled',
            'safetyGuidelinesAccepted', 'updatedAt'
          ])
          && isValidUserAccount(request.resource.data, userId)
          && hasValidTimestampsOnUpdate();
      allow delete: if isOwner(userId);

      match /savedPosts/{postId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
            && request.resource.data.keys().hasOnly([
              'userId', 'postId', 'postText', 'postType', 'postMediaUri',
              'anonymousLabel', 'createdAt', 'updatedAt'
            ])
            && isValidSavedOrLikedRef(request.resource.data, userId, postId)
            && hasValidTimestampsOnCreate();
        allow update: if isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'postText', 'postType', 'postMediaUri', 'anonymousLabel', 'updatedAt'
            ])
            && isValidSavedOrLikedRef(request.resource.data, userId, postId)
            && hasValidTimestampsOnUpdate();
        allow delete: if isOwner(userId);
      }

      match /likedPosts/{postId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
            && request.resource.data.keys().hasOnly([
              'userId', 'postId', 'postText', 'postType', 'postMediaUri',
              'anonymousLabel', 'createdAt', 'updatedAt'
            ])
            && isValidSavedOrLikedRef(request.resource.data, userId, postId)
            && hasValidTimestampsOnCreate();
        allow update: if isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'postText', 'postType', 'postMediaUri', 'anonymousLabel', 'updatedAt'
            ])
            && isValidSavedOrLikedRef(request.resource.data, userId, postId)
            && hasValidTimestampsOnUpdate();
        allow delete: if isOwner(userId);
      }

      match /blocks/{blockedUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
            && request.resource.data.keys().hasOnly([
              'userId', 'blockedUid', 'blockedLabel', 'createdAt', 'updatedAt'
            ])
            && isValidBlockRef(request.resource.data, userId, blockedUid)
            && hasValidTimestampsOnCreate();
        allow update: if isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'blockedLabel', 'updatedAt'
            ])
            && isValidBlockRef(request.resource.data, userId, blockedUid)
            && hasValidTimestampsOnUpdate();
        allow delete: if isOwner(userId);
      }

      match /following/{targetUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
            && request.resource.data.keys().hasOnly([
              'followerUid', 'targetUid', 'targetHandle', 'createdAt', 'updatedAt'
            ])
            && isValidFollowRef(request.resource.data, userId, targetUid)
            && hasValidTimestampsOnCreate();
        allow update: if isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'targetHandle', 'updatedAt'
            ])
            && isValidFollowRef(request.resource.data, userId, targetUid)
            && hasValidTimestampsOnUpdate();
        allow delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn()
            && request.resource.data.keys().hasOnly([
              'userId', 'type', 'title', 'body', 'targetId', 'isRead', 'createdAt', 'updatedAt'
            ])
            && isValidNotification(request.resource.data, userId)
            && hasValidTimestampsOnCreate();
        allow update: if isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isRead', 'updatedAt'
            ])
            && isValidNotification(request.resource.data, userId)
            && hasValidTimestampsOnUpdate();
        allow delete: if isOwner(userId);
      }
    }

    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'surname', 'anonymousHandle', 'gender', 'age', 'interests',
            'avatarKey', 'avatarUri', 'postCount', 'viewCount', 'likeCount',
            'followersCount', 'followingCount', 'createdAt', 'updatedAt'
          ])
          && isValidPublicProfile(request.resource.data, userId)
          && hasValidTimestampsOnCreate();
      allow update: if isSignedIn()
          && (
            (
              isOwner(userId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'displayName', 'surname', 'anonymousHandle', 'gender', 'age', 'interests',
                'avatarKey', 'avatarUri', 'postCount', 'viewCount', 'likeCount',
                'followersCount', 'followingCount', 'updatedAt'
              ])
              && isValidPublicProfile(request.resource.data, userId)
              && hasValidTimestampsOnUpdate()
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'viewCount', 'likeCount', 'followersCount', 'updatedAt'
              ])
              && isValidPublicProfile(request.resource.data, userId)
              && hasValidTimestampsOnUpdate()
            )
          );
      allow delete: if isOwner(userId);
    }

    match /posts/{postId} {
      allow read: if isSignedIn()
          && (resource.data.status == 'published' || resource.data.authorUid == request.auth.uid);

      allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'authorUid', 'anonymousLabel', 'anonymousHandle', 'authorAvatarUri', 'isAnonymous',
            'type', 'category', 'text', 'mediaUri', 'mediaCaption', 'mediaDurationSec',
            'mediaMimeType', 'topics', 'contentWarning', 'status', 'likeCount',
            'commentCount', 'viewCount', 'createdAt', 'updatedAt'
          ])
          && isValidConfessionPost(request.resource.data)
          && hasValidTimestampsOnCreate();

      allow update: if isSignedIn()
          && (
            (
              resource.data.authorUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'anonymousLabel', 'anonymousHandle', 'authorAvatarUri', 'isAnonymous', 'type',
                'category', 'text', 'mediaUri', 'mediaCaption', 'mediaDurationSec',
                'mediaMimeType', 'topics', 'contentWarning', 'status',
                'likeCount', 'commentCount', 'viewCount', 'updatedAt'
              ])
              && isValidConfessionPost(request.resource.data)
              && hasValidTimestampsOnUpdate()
            )
            || (
              resource.data.status == 'published'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'likeCount', 'commentCount', 'viewCount', 'updatedAt'
              ])
              && isValidConfessionPost(request.resource.data)
              && hasValidTimestampsOnUpdate()
            )
          );

      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.keys().hasOnly([
              'postId', 'authorUid', 'anonymousLabel', 'text', 'status', 'createdAt', 'updatedAt'
            ])
            && isValidComment(request.resource.data, postId)
            && hasValidTimestampsOnCreate();
        allow update: if isSignedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text', 'status', 'updatedAt'
            ])
            && isValidComment(request.resource.data, postId)
            && hasValidTimestampsOnUpdate();
        allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      }
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.initiatorUid
          && request.resource.data.keys().hasOnly([
            'participantUids', 'initiatorUid', 'recipientUid', 'status',
            'lastMessageText', 'lastMessageSenderUid', 'initiatorHandle',
            'recipientHandle', 'createdAt', 'updatedAt'
          ])
          && isValidConversation(request.resource.data)
          && hasValidTimestampsOnCreate();
      allow update: if isSignedIn()
          && request.auth.uid in resource.data.participantUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'lastMessageText', 'lastMessageSenderUid', 'updatedAt'
          ])
          && isValidConversation(request.resource.data)
          && hasValidTimestampsOnUpdate();
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        allow read: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow create: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids
            && request.resource.data.keys().hasOnly([
              'conversationId', 'senderUid', 'recipientUid', 'text', 'mediaUri', 'createdAt', 'updatedAt'
            ])
            && isValidDirectMessage(request.resource.data, conversationId)
            && hasValidTimestampsOnCreate();
        allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
      allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
            'reporterUid', 'targetType', 'targetId', 'reason', 'details', 'status', 'createdAt', 'updatedAt'
          ])
          && isValidReport(request.resource.data)
          && hasValidTimestampsOnCreate();
      allow update, delete: if false;
    }
  }
}
